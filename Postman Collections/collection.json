		{
			"name": "Booking",
			"item": [
				{
					"name": "GetBookingIds",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "906c6ba3-9c48-4122-8b3b-38cc787c74cd",
								"exec": [
									"/*data visualization part*/\r",
									"var template = `\r",
									"<div>total bookings <span>{{response.length}}</span></div>\r",
									"<table>\r",
									"  <tr bgcolor=\"LightGray\">\r",
									"    <th>Booking NO</th>\r",
									"    <th>Booking ID</th>\r",
									"  </tr>\r",
									"  {{#each response}}\r",
									"  <tr bgcolor=\"Orange\">\r",
									"    <td>{{@key}}</td>\r",
									"    <td>{{bookingid}}</td>\r",
									"  </tr>\r",
									"  {{/each}}\r",
									"</table>`;\r",
									"\r",
									"pm.visualizer.set(template, {\r",
									"  response: pm.response.json()\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"    \r",
									"    \r",
									"    \r",
									"var jsonData = pm.response.json();\r",
									"var bid;\r",
									"\r",
									"if(jsonData.length>0){\r",
									"        bid = jsonData[0].bookingid;\r",
									"\r",
									"}\r",
									"\r",
									"pm.test(\"Check booking data exist\", function () {\r",
									"   pm.expect(bid).not.null;\r",
									"});   \r",
									"\r",
									"//set booking id\r",
									"pm.collectionVariables.set(\"bookingid\", bid);\r",
									"\r",
									"\r",
									"   \r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
